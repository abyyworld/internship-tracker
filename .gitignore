# macOS
.DS_Store

# logs
watcher.log
*.log

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# generated personal apply triage (run copilot.py to regenerate locally)
apply_cockpit.html

# Private application state and generated CVs must never be committed.
private/
.private/
# Every provider keeps its own key file under private/. Named again here so a
# key saved anywhere else cannot be committed either.
*.key
# The bridge's bearer token and the one-shot approval tokens live in the same
# directory and are just as much credentials. AUTOAPPLY_HOME can point at a
# directory inside this checkout, where the private/ rule above does not reach
# them, so they are named too.
*.token
# The master CV PDF and its generator are personal documents. Their design is
# already reproduced in autoapply/cv_render.py, so the repository does not need
# the originals — and this repository is public.
my cv and the tool/
*.sqlite3
autofill.local.user.js
